{
  "name": "geometrix",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "geometrix",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": "^26"
      }
    },
    "apps/cli": {
      "name": "@geometrix/cli",
      "version": "0.0.0"
    },
    "apps/client": {
      "name": "@geometrix/client",
      "version": "0.0.0"
    },
    "apps/server": {
      "name": "@geometrix/server",
      "version": "0.0.0"
    },
    "node_modules/@geometrix/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@geometrix/client": {
      "resolved": "apps/client",
      "link": true
    },
    "node_modules/@geometrix/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@geometrix/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@geometrix/sim": {
      "resolved": "packages/sim",
      "link": true
    },
    "packages/protocol": {
      "name": "@geometrix/protocol",
      "version": "0.0.0"
    },
    "packages/sim": {
      "name": "@geometrix/sim",
      "version": "0.0.0"
    }
  }
}
