{
  "name": "geometrix",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts/capture --incremental --tsBuildInfoFile node_modules/.cache/tsc/capture.tsbuildinfo",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.ts",
    "check:fast": "node scripts/check.ts --fast",
    "geo": "node apps/cli/src/main.ts",
    "server": "node apps/server/src/main.ts",
    "dev:multi": "node apps/server/src/dev-multi-main.ts",
    "soak": "node apps/server/src/soak-main.ts",
    "client": "npm run dev -w @geometrix/client",
    "lab": "npm run dev -w @geometrix/client -- --open /lab.html",
    "build": "npm run build -w @geometrix/client",
    "capture": "node scripts/capture/capture.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true
  }
}
